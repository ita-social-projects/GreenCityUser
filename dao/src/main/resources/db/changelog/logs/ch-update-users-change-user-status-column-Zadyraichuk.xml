<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
    <changeSet id="updateUserStatusColumnZadyraichuk" author="Rostyslav Zadyraichuk">
        <dropColumn tableName="users" columnName="user_status"/>
        <addColumn tableName="users">
            <column name="user_status" type="varchar(30)" defaultValue="CREATED">
                <constraints nullable="false" />
            </column>
        </addColumn>
        <update tableName="users">
            <column name="user_status" value="VERIFIED"/>
        </update>

        <rollback>
            <dropColumn tableName="users" columnName="user_status"/>
            <addColumn tableName="users">
                <column name="user_status" type="int" defaultValue="2">
                    <constraints nullable="false" />
                </column>
            </addColumn>
        </rollback>
    </changeSet>
</databaseChangeLog>