<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2025-08-20-01-create-authority-category" author="Oleh Popovych">
        <createTable tableName="authority_category">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name_en" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name_uk" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="authority_category"/>
        </rollback>
    </changeSet>

    <changeSet id="2025-08-20-02-add-category-and-description" author="Oleh Popovych">
        <addColumn tableName="employee_authorities">
            <column name="category_id" type="BIGINT"/>
            <column name="description_en" type="VARCHAR(500)"/>
            <column name="description_uk" type="VARCHAR(500)"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="employee_authorities"
                baseColumnNames="category_id"
                constraintName="fk_authority_category"
                referencedTableName="authority_category"
                referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint
                    baseTableName="employee_authorities"
                    constraintName="fk_authority_category"/>
            <dropColumn tableName="employee_authorities" columnName="category_id"/>
            <dropColumn tableName="employee_authorities" columnName="description_en"/>
            <dropColumn tableName="employee_authorities" columnName="description_uk"/>
        </rollback>
    </changeSet>

