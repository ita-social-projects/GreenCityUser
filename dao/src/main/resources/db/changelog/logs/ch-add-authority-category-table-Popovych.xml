            <column name="name_uk" value="Тарифи"/>
        </insert>
        <insert tableName="authority_category">
            <column name="id" valueNumeric="7"/>
            <column name="name_en" value="Logistics"/>
            <column name="name_uk" value="Логістика"/>
        </insert>
        <insert tableName="authority_category">
            <column name="id" valueNumeric="8"/>
            <column name="name_en" value="Agreements"/>
            <column name="name_uk" value="Угоди"/>
        </insert>
        <insert tableName="authority_category">
            <column name="id" valueNumeric="9"/>
            <column name="name_en" value="Bots Management"/>
            <column name="name_uk" value="Управління ботами"/>
        </insert>
        <rollback>
            <delete tableName="authority_category">
                <where>id IN (1,2,3,4,5,6,7,8,9)</where>
            </delete>
        </rollback>
    </changeSet>

